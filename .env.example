# Copy to .env.local and fill in. Never commit real secrets.
# A random secret of at least 32 characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# The public URL of the site (used for cookies, CSRF origin checks, canonical URLs and the sitemap)
BETTER_AUTH_URL=http://localhost:3000
# Postgres connection string. On Vercel, the Neon integration adds it for you.
# Locally, use a Neon development branch or a local Postgres, for example
# postgres://carebite:your-password@localhost:5432/carebite
DATABASE_URL=
# Optional: your own admin account, created on first start if it does not exist yet.
# Unlike the shared demo admin (admin.demo), its password is private. Changing these later
# does not change an existing account; change the password in Settings instead.
# ADMIN_USERNAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=

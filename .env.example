# Copy to .env.local and fill in. Never commit real secrets.
# A random secret of at least 32 characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# The public URL of the site (used for cookies, CSRF origin checks, canonical URLs and the sitemap)
BETTER_AUTH_URL=http://localhost:3000
# Optional: SQLite database file (default: var/carebite.db, or /tmp/carebite.db on Vercel)
# CAREBITE_DB=var/carebite.db
